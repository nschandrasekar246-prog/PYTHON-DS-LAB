        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "\n",
        "class CircularLinkedList:\n",
        "    def __init__(self):\n",
        "        self.last = None\n",
        "\n",
        "    # Add node to an empty list\n",
        "    def addToEmpty(self, data):\n",
        "        if self.last is not None:\n",
        "            return self.last\n",
        "\n",
        "        temp = Node(data)\n",
        "        self.last = temp\n",
        "        self.last.next = self.last\n",
        "\n",
        "        return self.last\n",
        "\n",
        "    # Add node at beginning\n",
        "    def addBegin(self, data):\n",
        "        if self.last is None:\n",
        "            return self.addToEmpty(data)\n",
        "\n",
        "        temp = Node(data)\n",
        "        temp.next = self.last.next\n",
        "        self.last.next = temp\n",
        "\n",
        "        return self.last\n",
        "\n",
        "    # Add node at end\n",
        "    def addEnd(self, data):\n",
        "        if self.last is None:\n",
        "            return self.addToEmpty(data)\n",
        "\n",
        "        temp = Node(data)\n",
        "        temp.next = self.last.next\n",
        "        self.last.next = temp\n",
        "        self.last = temp\n",
        "\n",
        "        return self.last\n",
        "\n",
        "    # Add node after a particular item\n",
        "    def addAfter(self, data, item):\n",
        "        if self.last is None:\n",
        "            return None\n",
        "\n",
        "        temp = Node(data)\n",
        "        p = self.last.next\n",
        "\n",
        "        while True:\n",
        "            if p.data == item:\n",
        "                temp.next = p.next\n",
        "                p.next = temp\n",
        "\n",
        "                if p == self.last:\n",
        "                    self.last = temp\n",
        "\n",
        "                return self.last\n",
        "\n",
        "            p = p.next\n",
        "\n",
        "            if p == self.last.next:\n",
        "                print(item, \"not present in the list\")\n",
        "                break\n",
        "\n",
        "        return self.last\n",
        "\n",
        "    # Traverse the circular linked list\n",
        "    def traverse(self):\n",
        "        if self.last is None:\n",
        "            print(\"List is empty\")\n",
        "            return\n",
        "\n",
        "        temp = self.last.next\n",
        "\n",
        "        while True:\n",
        "            print(temp.data, end=\" \")\n",
        "            temp = temp.next\n",
        "\n",
        "            if temp == self.last.next:\n",
        "                break\n",
        "\n",
        "\n",
        "# Main program\n",
        "if __name__ == \"__main__\":\n",
        "    llist = CircularLinkedList()\n",
        "\n",
        "    last = llist.addToEmpty(6)\n",
        "    last = llist.addBegin(4)\n",
        "    last = llist.addBegin(2)\n",
        "    last = llist.addEnd(8)\n",
        "    last = llist.addEnd(12)\n",
        "    last = llist.addAfter(10, 8)\n",
        "\n",
        "    llist.traverse()"
      ]
