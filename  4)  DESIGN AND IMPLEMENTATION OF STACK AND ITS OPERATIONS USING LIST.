      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "\n",
        "class Stack:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "\n",
        "    def isempty(self):\n",
        "        if self.head == None:\n",
        "            return True\n",
        "        else:\n",
        "            return False\n",
        "\n",
        "    def push(self, data):\n",
        "        if self.head == None:\n",
        "            self.head = Node(data)\n",
        "        else:\n",
        "            newnode = Node(data)\n",
        "            newnode.next = self.head\n",
        "            self.head = newnode\n",
        "\n",
        "    def pop(self):\n",
        "        if self.isempty():\n",
        "            return None\n",
        "        else:\n",
        "            poppednode = self.head\n",
        "            self.head = self.head.next\n",
        "            poppednode.next = None\n",
        "            return poppednode.data\n",
        "\n",
        "    def peek(self):\n",
        "        if self.isempty():\n",
        "            return None\n",
        "        else:\n",
        "            return self.head.data\n",
        "\n",
        "    def display(self):\n",
        "        iternode = self.head\n",
        "\n",
        "        if self.isempty():\n",
        "            print(\"Stack Underflow\")\n",
        "        else:\n",
        "            while iternode != None:\n",
        "                print(iternode.data, \"->\", end=\" \")\n",
        "                iternode = iternode.next\n",
        "            return\n",
        "\n",
        "\n",
        "# Create Stack\n",
        "MyStack = Stack()\n",
        "\n",
        "# Push elements\n",
        "MyStack.push(11)\n",
        "MyStack.push(22)\n",
        "MyStack.push(33)\n",
        "MyStack.push(44)\n",
        "\n",
        "# Display stack\n",
        "MyStack.display()\n",
        "\n",
        "# Display top element\n",
        "print(\"\\nTop element is\", MyStack.peek())\n",
        "\n",
        "# Pop two elements\n",
        "MyStack.pop()\n",
        "MyStack.pop()\n",
        "\n",
        "# Display stack again\n",
        "MyStack.display()\n",
        "\n",
        "# Display top element\n",
        "print(\"\\nTop element is\", MyStack.peek())"
      ]
